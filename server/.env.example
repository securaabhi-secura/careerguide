NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Postgres connection string.
# - On Vercel: add the "Postgres" storage integration in your project dashboard
#   and this is set automatically (Vercel Postgres is powered by Neon).
# - Locally: point this at any Postgres instance — a local install, a free
#   Neon/Supabase project, or `vercel env pull .env.development.local` after
#   linking your project to pull the real value down.
POSTGRES_URL=postgres://user:password@localhost:5432/careerguide
